# Local dev + build. Copy this file to .env.local and adjust as needed.

# Auth.js v5 secret — generate with: openssl rand -base64 32
AUTH_SECRET=dev-secret-change-me-in-production-0123456789abcdef

# Postgres connection. When empty, the app runs on an embedded PGlite database
# stored in ./local.db — zero setup for local dev. On Vercel, set
# DATABASE_URL to your Neon connection string (Storage → Create Database).
DATABASE_URL=

# environment marker for deploy debugging
NEXT_PUBLIC_DEPLOY=1
